# ============ Notifications (REQUIRED) ============
# Your private ntfy topic. Anyone who knows this string can read your alerts,
# so it must be long and random. Generate a fresh one with:
#   openssl rand -hex 24
# then prefix it however you like. NEVER commit the real .env file.
NTFY_TOPIC=replace-me-with-a-long-random-topic
NTFY_SERVER=https://ntfy.sh

# ============ Cineplex target (defaults are correct for this project) ============
# Public web API key that cineplex.com ships to every visitor's browser.
# It is site configuration, not a personal secret. If Cineplex rotates it,
# see README "Troubleshooting Cineplex parsing" for how to grab the new one.
CINEPLEX_API_KEY=dcdac5601d864addbc2675a2e96cb1f8
LOCATION_ID=9406            # Cinéma Banque Scotia Montréal (977 Ste-Catherine O)
FILM_ID=37617               # The Odyssey
FILM_NAME_HINT=odyssey
THEATRE_NAME=Cinéma Banque Scotia Montréal

# Alert only for show dates strictly AFTER this date.
ALERT_AFTER_DATE=2026-09-16

# ============ Check cadence ============
FAST_INTERVAL_MINUTES=2     # during likely ticket-release windows
SLOW_INTERVAL_MINUTES=12    # the rest of the time
FAST_WINDOW_DAYS=Tue,Wed,Thu
FAST_WINDOW_HOURS=07-14     # 24h clock, America/Toronto
JITTER_SECONDS=20           # random +/- seconds so checks never land on the exact second

# ============ Behaviour ============
DRY_RUN=false               # true = log what WOULD alert, send nothing, save nothing
RECOVERY_AFTER_FAILURES=25  # send one "recovered" note after this many straight failures
